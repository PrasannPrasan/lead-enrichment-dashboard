DATABASE_URL="postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres?schema=public"
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-a-strong-password"

# Used to encrypt API keys saved from the admin settings UI.
# Defaults to NEXTAUTH_SECRET if omitted, but a separate random value is recommended.
API_KEY_ENCRYPTION_SECRET="replace-with-a-random-32-byte-secret"

NINJAPEAR_API_KEY=""
PROXYCURL_API_KEY=""
APOLLO_API_KEY=""
HUNTER_API_KEY=""
PDL_API_KEY=""

DROPCONTACT_API_KEY=""
SNOV_CLIENT_ID=""
SNOV_CLIENT_SECRET=""
FINDYMAIL_API_KEY=""
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""

# Local demo mode returns deterministic mock data from adapters when paid API keys are absent.
# Keep false in production unless you intentionally want demo data.
MOCK_PROVIDER_MODE="true"
